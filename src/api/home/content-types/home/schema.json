{
  "kind": "singleType",
  "collectionName": "homes",
  "info": {
    "singularName": "home",
    "pluralName": "homes",
    "displayName": "Home",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Heading": {
      "type": "string"
    },
    "ButtonText": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "HomeBanner": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "HomeMobileBanner": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "SubHeading": {
      "type": "string"
    },
    "HomeCollection": {
      "type": "component",
      "repeatable": true,
      "component": "collections.home-collection"
    },
    "HomeAds": {
      "type": "component",
      "repeatable": true,
      "component": "homeads.home-ads"
    },
    "Home_Video": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "Annoucement_Heading": {
      "type": "string"
    },
    "Annoucement_Url": {
      "type": "string"
    },
    "Top_Banner_Color": {
      "type": "customField",
      "regex": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$",
      "customField": "plugin::color-picker.color"
    },
    "Sub_Heading_Color": {
      "type": "customField",
      "regex": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$",
      "customField": "plugin::color-picker.color"
    }
  }
}
